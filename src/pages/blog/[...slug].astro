---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import { getEntry, render } from "astro:content";
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.addComment);
if (result && !result.error) {
  return Astro.redirect(`${Astro.url.pathname}#comments`);
}

const { slug } = Astro.params;
const post = await getEntry("blog", slug!);

if (!post) return Astro.redirect("/blog");

const { Content } = await render(post);
---

<Base title={`${post.data.title} — Ian West`} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Comments postSlug={post.id} />
</Base>

<style>
  article header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2rem;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
  }

  time {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .prose {
    line-height: 1.75;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.25rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0;
  }
</style>
